# Node backend: hand upload, Game Mode, four-snap capture, card recognition
# proxying, and the server-authoritative multiplayer tables.
#
# Build:
#   docker build -f docker/Dockerfile.server -t ai-cards-server:latest .
#
# Run:
#   docker run -d --name ai-cards \
#     -p 3001:3001 \
#     -v /path/to/long-term-storage:/data \
#     ai-cards-server:latest
#
# Prefer `docker compose up` — it wires the optional ML recognizer and Signal
# bot services in for you.

FROM node:20-alpine AS build

WORKDIR /app
COPY package*.json ./
# Install EVERYTHING including devDeps (needed for esbuild + react-scripts
# to build the frontend and the server-side engine bundle).
#
# `npm install`, not `npm ci`: the committed package-lock.json is not in sync
# with package.json (its tailwindcss subtree is missing postcss-load-config,
# so `npm ci` fails with "Missing: yaml@2.9.0 from lock file"). Regenerating
# the lock resolves that but then picks a typescript major that react-scripts
# 5.0.1 rejects. Until the lockfile is repaired this trades reproducibility
# for a working build — switch back to `npm ci` once it is.
RUN npm install --no-audit --no-fund

COPY . .

# The React frontend (all routes, including /upload and /multiplayer).
RUN DISABLE_ESLINT_PLUGIN=true CI=false npm run build

# The Bid Whist engine, bundled for Node. Without this the server still
# serves every upload feature, but multiplayer games cannot start.
RUN npm run build:engine


FROM node:20-alpine AS runtime

WORKDIR /app

COPY package*.json ./
# See the note in the build stage above for why this is not `npm ci`.
RUN npm install --omit=dev --no-audit --no-fund

COPY --from=build /app/server ./server
COPY --from=build /app/build ./build

# Long-term storage plus operator-editable config:
#   /data/games         Game Mode zips
#   /data/announce.json Signal announcer settings (optional)
#   /data/profanity.json extra profanity wordlist (optional)
VOLUME ["/data"]
ENV GAME_MODE_STORAGE=/data/games
ENV PORT=3001

# Card detection ML service. Compose points this at the `ml` service; on its
# own, set --env ML_SERVICE_URL=... to a reachable recognizer.
ENV ML_SERVICE_URL=http://localhost:3002

# Announcer defaults to a no-op adapter, so the server runs fine with no
# Signal account at all. See docker/SIGNAL.md to turn it on.
ENV ANNOUNCE_ADAPTER=noop

EXPOSE 3001
CMD ["node", "server/server.js"]
